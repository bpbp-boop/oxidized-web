.row
  .col-4
    %h4
      %a.link-body-emphasis.link-underline-opacity-0{href: url_for('/nodes')} nodes
      \/ stats
  .col-8
    %form.float-end#oxButtons
      %button.btn.btn-primary{type: 'button', onclick: 'history.go();'}
        %i.bi.bi-arrow-clockwise
        Refresh page
      %button.btn.btn-primary#resetSearch{type: 'button'}
        %i.bi.bi-eraser-fill
        Reset search

.row
  .table-responsive
    %table.table.table-sm.table-striped.table-hover#statsTable
      %thead
        %tr
          %th Name
          %th Total Runs
          %th Total Failures
          %th Failure Rate
          %th Average Run Time
          %th Last Status
          %th Last Update
          %th Last Failure

      %tbody

:javascript
  var oxBaseUrl = "#{url_for('/')}";

  function oxEscHtml(str) {
    if (str == null) return '';
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function oxFmtEpoch(epoch) {
    if (!epoch || epoch === 0) return 'never';
    return dayjs.unix(epoch).local().format('YYYY-MM-DD HH:mm:ss [(UTC]Z[)]');
  }

  function oxPlaceButtons(api) {
    api.buttons(0, 0).container().prependTo($('#oxButtons'));
    api.buttons(0, 0).nodes().removeClass('btn-secondary');
  }

  $(function() {
    var table = $('#statsTable').DataTable(Object.assign({
      serverSide: true,
      processing: true,
      ajax: { url: oxBaseUrl + 'nodes/stats/datatables' },
      order: [[0, 'asc']],
      columnDefs: [
        {
          /* do not permit to hide Name and Last Status */
          targets: [0, 5],
          className: 'noVis'
        },
      ],
      columns: [
        /* 0 – Name */
        { data: 'name', render: function(data, type) {
          return type === 'display' ? oxEscHtml(data) : data;
        }},
        /* 1 – Total Runs */
        { data: 'total_runs' },
        /* 2 – Total Failures */
        { data: 'failures' },
        /* 3 – Failure Rate */
        { data: 'failure_rate', render: function(data, type) {
          return type === 'display' ? Number(data).toFixed(2) + '%' : data;
        }},
        /* 4 – Average Run Time */
        { data: 'avg_time', render: function(data, type) {
          return type === 'display' ? Number(data).toFixed(2) : data;
        }},
        /* 5 – Last Status */
        { data: 'status', render: function(data, type) {
          if (type === 'display') {
            var s = oxEscHtml(data);
            return '<div title="' + s + '" class="' + s + '">'
                   + '<span style="visibility: hidden">' + s + '</span></div>';
          }
          return data;
        }},
        /* 6 – Last Update (last successful run) */
        { data: 'last_success', render: function(data, type) {
          return type === 'display' ? oxFmtEpoch(data) : data;
        }},
        /* 7 – Last Failure */
        { data: 'last_failure', render: function(data, type) {
          return type === 'display' ? oxFmtEpoch(data) : data;
        }},
      ],
      createdRow: function(row, data) {
        if (data.row_class) { $(row).addClass(data.row_class); }
      },
      buttons:
        [{
          extend: 'colvis',
          columns: ':not(.noVis)',
          className: 'btn-primary',
        }],
      autoWidth: false,
      lengthMenu: [20, 50, 250, 500],
      stateLoadParams: function(settings, data) {
        if (data.length === -1 || data.length > 500) { data.length = 20; }
      },
      initComplete: function() {
        oxPlaceButtons(this.api());
      },
    }, dataTableStateOptions('statsTable')));

    $('#resetSearch').on('click', function() {
        table.search('').draw();
    });
  });
